# ===== Copy these into Hugging Face Space -> Settings -> Variables and secrets =====
# Put ONLY the ones you get. Each provider auto-enables when its key is set.
# Required
AGENT_TOKEN=change-this-to-a-long-random-password

# LLM keys (free tiers) - add as many as you like; fallback goes in this order
GROQ_API_KEY=            # console.groq.com
GEMINI_API_KEY=          # aistudio.google.com/apikey
OPENROUTER_API_KEY=      # openrouter.ai/keys
MISTRAL_API_KEY=         # console.mistral.ai
CEREBRAS_API_KEY=        # cloud.cerebras.ai
HF_TOKEN=                # huggingface.co/settings/tokens (Inference Providers credits)

# Optional: force the order, e.g. gemini first
# LLM_PROVIDER_ORDER=gemini,groq,openrouter,mistral,cerebras,huggingface
# Optional: override a model, e.g. GEMINI_MODEL=gemini-2.5-pro

# Search (optional; without keys DuckDuckGo is used)
TAVILY_API_KEY=          # tavily.com (1,000 free credits/month)
BRAVE_API_KEY=           # brave.com/search/api ($5 free credits/month)

# Tools
ENABLE_SHELL=0
GH_TOKEN=                # GitHub token (repo + workflow) for APK build trigger
GH_REPO=codexanta/website
